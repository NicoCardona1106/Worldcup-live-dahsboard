# Copy this file to .env.local for local development,
# and add the same variable in your Vercel project settings for production.

# Required for the AI assistant button (/api/ai). Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: only needed if/when you wire up real live-match data.
# Get a key at https://www.api-football.com or https://www.football-data.org
FOOTBALL_DATA_API_KEY=
